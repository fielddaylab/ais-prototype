#basePath TestChapter

:: Start
@trigger    ChapterStart
@cutscene

{@Narrator} {char-name ???} "'Twas a dark and stormy..."
            Hang on. Wrong story. Let me start over.
            "And then at the stroke of..."
            No no that's all wrong too. Oh for...
{@Player}   Hello?
{@Narrator} {char-name ???}     Oh dang it, I thought I'd been really quiet too.
                Guess I'll need to start your story from scratch <i>again</i>.
{@Player}       Uhhhhhh what do you mean?
{@Narrator}     Listen, kid, we don't have much time.
                I need you to take some stat bonuses.
                But first let me go to this room.

$call SetBackground("bg/Room.png")
$set local:pointsToAllocate = 4
$branch .StatBonusLoop

:: StatBonusLoop
$if !local:pointsToAllocate
    $goto .Finishing
$endif // 

$set local:pointsToAllocate - 1

$choice .ChooseTech; Adjust my tech.
$choice .ChooseRanger; Adjust my outdoors-y-ness.
$choice .ChooseNo; What about no?
    $data   CheckStat = "Communicate"
    $data   CheckStatValue = 4

:: ChooseTech
$call AdjustStat(Tech, 1)
{@} Your Tech stat is now {$Stat(Tech)}!
$goto .StatBonusLoop

:: ChooseRanger
$call AdjustStat(Ranger, 1)
{@} Your Ranger stat is now {$Stat(Ranger)}!
$if !HasEvidenceCard("Evidence-Angler")
    {@Narrator}     Hang on, I also have something for you...
                    Let me just... check my pockets...
                    Here you go!
    $call GiveEvidenceCard("Evidence-Angler")
    {@}     You obtained an evidence card! Check your Evidence menu for details!
$endif
$if HasEvidenceCard("Evidence-Angler")
    $if !HasEvidenceCard("Evidence-Chemical-Removal")
        {@Narrator}     Oh, looks like you already know about Bait Buckets.
                        How about this one?
        $call GiveEvidenceCard("Evidence-Chemical-Removal")
        {@}     You obtained an evidence card! Check your Evidence menu for details!
    $endif
$endif
$if HasEvidenceCard("Evidence-Chemical-Removal")
    {@}   You've got the new action card which allows you to apply chemical removal!
$endif
$goto .StatBonusLoop

:: ChooseNo
{@Narrator}     ...huh.
$goto .Finishing

:: Finishing

$call BeginIntervention()