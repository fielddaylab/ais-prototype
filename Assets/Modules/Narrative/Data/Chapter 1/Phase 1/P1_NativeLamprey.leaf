#basePath P1_NativeLamprey
#include "Header.leaf"

:: Start
@trigger    OnLocationChanged
// "NONE" ensures no other threads are in-progress
// global:currentPhase == 1 ensures player is in phase 1
@when       global:currentThread == "NONE", global:currentPhase == 1, location == "DNROffice"
@cutscene
// Lock all location on map
$call SetInThreadLocks()
$call DisableMapButton()

// Mark start of thread
$set global:currentThread = "P1_NativeLamprey"

$call  ClearVisibleLines()
{@}     
       You talk to people here and gain an action card.
       // [This is the Native Lamprey thread in Phase 1.]

// TODO: Rest of thread here

$call GiveActionCard("example-action-card-1")

       [Open your map to continue]


// TEMPORARY: skip to end
$goto .End


:: End
@tracked
// Unlock next locations
$call UnlockLocation(ResearchLab)  // P1_Lamprey

// Mark end of thread
$set global:currentThread = "NONE"

// Go to Phase 1 Continue Hub
$goto P1_Hub.Continue