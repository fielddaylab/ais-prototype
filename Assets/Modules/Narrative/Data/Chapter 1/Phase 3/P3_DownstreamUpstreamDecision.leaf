#basePath P3_DownstreamUpstreamDecision

:: Decide
@trigger    OnLocationChanged
// "NONE" ensures no other threads are in-progress
// global:currentPhase == 3 ensures player is in phase 3
@when       global:currentThread == "NONE", global:currentPhase == 3, location == "FieldStationTraps"
@cutscene
// Lock all location on map
$call SetInThreadLocks()


{@}   
       [This is where the player decides whether to pursue P3_LampreyDownstream or P3_LampreyUpstream]

$OnceChoice(P3_LampreyDownstream.Start, "Enter LampreyDownstream Thread")
$OnceChoice(P3_LampreyUpstream.Start, "Enter LampreyUpstream Thread")