#basePath P3_DownstreamUpstreamDecision
#include "Header.leaf"

:: Decide
@exposed
@trigger    OnLocationChanged
// "NONE" ensures no other threads are in-progress
// global:currentPhase == 3 ensures player is in phase 3
@when       global:currentThread == "NONE", global:currentPhase == 3, location == "FieldStationTraps"
@cutscene
// Lock all location on map
$call SetInThreadLocks()
$call DisableMapButton()

//splits dialogue based on whether the player has been to this section before
$if global:upstreamFirst == false
       $if global:downstreamFirst == false
       {@}   
              You're surprised to find Claire is already in the river, wading by the traps.

       {@You}
              You're incredibly efficient, Claire.

       {@Claire}
              Wrong! My car is incredibly efficient!
              But yes, I like to stay on my feet!
              Care to take a swim, young scientist?

       {@You}
              Not really. 

       {@}
              You join her in the river anyway.

       {@You}
              What are you working on?

       {@Claire}
              I'm checking to ensure the traps are facing the correct direction!

       {@You}
              Does the direction really matter?

       {@Claire}
              Yes, it does! 
              The water in this tributary, like all tributaries, flows towards the lake. 
              The sea lamprey either swim downstream or upstream, depending on what phase of life they are in!

       {@You}
              That's interesting. When do the sea lamprey go...
       $OnceChoice(P3_LampreyDownstream.Start, downstream?)
       $OnceChoice(P3_LampreyUpstream.Start, upstream?)
       $else
       {@Claire}
              Young scientist! Do you have more questions for me?
       $OnceChoice(P3_LampreyUpstream.Start, So, when do sea lamprey go upstream?)
       $endif
$elseif global:downstreamFirst == false
       $if global:upstreamFirst == false
       {@}   
              You're surprised to find Claire is already in the river, wading by the traps.

       {@You}
              You're incredibly efficient, Claire.

       {@Claire}
              Wrong! My car is incredibly efficient!
              But yes, I like to stay on my feet!
              Care to take a swim, young scientist?

       {@You}
              Not really. 

       {@}
              You join her in the river anyway.

       {@You}
              What are you working on?

       {@Claire}
              I'm checking to ensure the traps are facing the correct direction!

       {@You}
              Does the direction really matter?

       {@Claire}
              Yes, it does! 
              The water in this tributary, like all tributaries, flows towards the lake. 
              The sea lamprey either swim downstream or upstream, depending on what phase of life they are in!

       {@You}
              That's interesting. When do the sea lamprey go...
       $OnceChoice(P3_LampreyDownstream.Start, downstream?)
       $OnceChoice(P3_LampreyUpstream.Start, upstream?)
       $else
       {@Claire}
              Young scientist! Do you have any more questions for me?
       $OnceChoice(P3_LampreyDownstream.Start, So, when do sea lamprey go downstream?)
       $endif
$endif