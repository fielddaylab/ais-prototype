#basePath P3_LampreyDownstream
#include "Header.leaf"

:: Start
@exposed
@cutscene

// Mark start of thread
$set global:currentThread = "P3_LampreyDownstream"

{@}   
       [This is the start of the Phase 3 thread LampreyDownstream.]

// TODO: Rest of thread here

// TODO: Give evidence chip
// $call GiveEvidenceChip([Evidence])

$call UnlockLocation(DNROffice)
$call EnableMapButton()



:: AtDNROffice
@trigger    OnLocationChanged
// global:currentThread ensures the correct thread
// global:currentPhase == 3 ensures player is in phase 3
@when       global:currentThread == "P3_LampreyDownstream", global:currentPhase == 3, location == "DNROffice"
// Lock all location on map
$call SetInThreadLocks()
$call DisableMapButton()

{@}   
       [This is the DNR Office section.]

// TODO: Rest of DNR Office section here

// TODO: Give evidence chip
// $call GiveEvidenceChip([Evidence])

$call UnlockLocation(ArmyCorps)
$call EnableMapButton()


:: AtArmyCorps
@trigger    OnLocationChanged
// global:currentThread ensures the correct thread
// global:currentPhase == 3 ensures player is in phase 3
@when       global:currentThread == "P3_LampreyDownstream", global:currentPhase == 3, location == "ArmyCorps"
// Lock all location on map
$call SetInThreadLocks()
$call DisableMapButton()

{@}   
       [This is the Army Corps section.]

// TODO: Rest of Army Corps section here

// TODO: Give action card (traps on downstream)
// $call GiveActionCard([Action])

// TODO: Give action card IF High research (traps on upstream)
$if StatCheck(Research, 3)
       $if HasActionCard()
              // handle player already has action card from LampreyUpstream thread
       $else
              // $call GiveActionCard([Action])
       $endif
$endif

// skip to end
$goto .End


:: End
@exposed
@tracked

// Mark end of thread
$set global:currentThread = "NONE"

// Go to Phase 2 Continue Hub
$goto P3_Hub.Continue