#basePath P3_CiscoTroutDecision

:: Decide
@trigger    OnLocationChanged
// "NONE" ensures no other threads are in-progress
// global:currentPhase == 3 ensures player is in phase 3
@when       global:currentThread == "NONE", global:currentPhase == 3, location == "[Location]"
@cutscene
// Lock all location on map
$call SetInThreadLocks()


{@}   
       [This is where the player decides whether to pursue P3_CiscoPop or P3_TroutPop]

$OnceChoice(P3_CiscoPop.Start, "Enter CiscoPop Thread")
$OnceChoice(P3_TroutPop.Start, "Enter TroutPop Thread")